FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /e2e
RUN apt-get update && apt-get install -y --no-install-recommends chromium ca-certificates && rm -rf /var/lib/apt/lists/*
RUN python -m pip install --no-cache-dir playwright==1.55.0
COPY scripts/sdk_p1_browser_preview_e2e.py /e2e/sdk_p1_browser_preview_e2e.py
CMD ["python", "/e2e/sdk_p1_browser_preview_e2e.py"]
